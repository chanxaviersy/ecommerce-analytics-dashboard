# ==========================================
# 电商仪表板 - 环境变量示例
# ==========================================
# 复制此文件为 .env 并填入你的实际配置：
#   cp .env.example .env
# ⚠️ .env 已加入 .gitignore，不会被提交

# ---------- 数据库 ----------
# SQLite 数据库路径（默认 data/ecommerce.db）
DATABASE_PATH=data/ecommerce.db
# 数据集生成开关
GENERATE_SAMPLE_DATA=true

# ---------- 仪表板 ----------
# Streamlit 端口
STREAMLIT_PORT=8501
# 主题
STREAMLIT_THEME=light

# ---------- 业务参数 ----------
# RFM 分群最近一次购买天数阈值
RFM_RECENCY_DAYS=90
# CLV 预测期（月）
CLV_MONTHS=12
